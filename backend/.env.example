# Comma-separated list of origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# Optional: override the path to the static product data.
# PRODUCTS_FILE=app/data/products.json

# Optional: static frontend served at "/". Created by `npm run build` in frontend/ (default: ../frontend/out).
# FRONTEND_DIR=../frontend/out
