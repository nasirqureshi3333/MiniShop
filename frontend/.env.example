# Optional: copy to .env.local to override the defaults in .env.development / .env.production.
#
# Backend API URL used by the browser, including the /api prefix.
# - npm run dev   (.env.development): http://localhost:8000/api
# - npm run build (.env.production):  /api  (the build is served by the backend, same origin)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
